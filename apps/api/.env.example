# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dextea

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos 统一配置中心（预留能力，配置 NACOS_SERVER_ADDR 即启用）
# 启用后配置优先级：.env > 环境变量 > nacos > 兜底
NACOS_SERVER_ADDR=
NACOS_DATA_ID=dextea-admin
NACOS_GROUP=DEFAULT_GROUP
# 命名空间 ID（对应 Nacos 的 namespace / tenant，留空为 public）
NACOS_NAMESPACE=
# 开启鉴权时填写（Basic Auth）
NACOS_USERNAME=
NACOS_PASSWORD=

# 高德地图 Web服务 API Key（后端地理编码）
AMAP_KEY=your-amap-web-service-key

# 高德地图 JavaScript API Key（前端地图展示，与 AMAP_KEY 不同）
AMAP_JS_KEY=your-amap-js-api-key

# 高德地图 JS API 安全密钥（前端地图展示）
# 控制台「应用管理」→「添加安全密钥」→ securityJsCode
AMAP_JS_SECURITY_CODE=your_security_js_code
