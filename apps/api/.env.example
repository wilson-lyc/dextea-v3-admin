# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dextea_admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 高德地图 Web服务 API Key（后端地理编码）
AMAP_KEY=your-amap-web-service-key

# 高德地图 JavaScript API Key（前端地图展示，与 AMAP_KEY 不同）
AMAP_JS_KEY=your-amap-js-api-key

# 高德地图 JS API 安全密钥（前端地图展示）
# 控制台「应用管理」→「添加安全密钥」→ securityJsCode
AMAP_JS_SECURITY_CODE=your_security_js_code

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_FROM=noreply@example.com
