# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dextea

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos
NACOS_SERVER_ADDR=
NACOS_DATA_ID=dextea-admin
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=

# 高德地图 Web服务 API Key
AMAP_KEY=your-amap-web-service-key

# 高德地图 JavaScript API Key
AMAP_JS_KEY=your-amap-js-api-key
AMAP_JS_SECURITY_CODE=your_security_js_code
