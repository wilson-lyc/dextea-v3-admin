# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dextea

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos
NACOS_SERVER_ADDR=
NACOS_DATA_ID=dextea-admin
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=

# 高德地图 Web服务 API Key
AMAP_KEY=your-amap-web-service-key

# 高德地图 JavaScript API Key
AMAP_JS_KEY=your-amap-js-api-key
AMAP_JS_SECURITY_CODE=your_security_js_code

# 存储位置 secretKey 加密密钥
# 用于加密数据库 storage_locations 表中存储的访问密钥（SK），请务必使用独立、足够随机的字符串。
# 注意：更换此密钥后将无法解密历史已加密的 secretKey，需重新在「存储位置」中填写密钥。
# 示例：a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4（建议 32 位以上随机字符）
STORAGE_ENCRYPTION_KEY=