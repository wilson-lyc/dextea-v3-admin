# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dextea

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos
NACOS_SERVER_ADDR=
NACOS_DATA_ID=dextea-admin
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=

# 高德地图 Web服务 API Key
AMAP_KEY=your-amap-web-service-key

# 高德地图 JavaScript API Key
AMAP_JS_KEY=your-amap-js-api-key
AMAP_JS_SECURITY_CODE=your_security_js_code

# 图库（对象存储，前端直连，鉴权由存储服务商完成）
# 存储厂商标识：用于选择内置的 S3 兼容预设（决定默认 endpoint 与寻址风格）。
# 可选值：aws / aliyun / tencent / minio / generic。
# 示例：aws ｜ 一般情况保持默认即可；使用 MinIO 或自建 S3 时改为 minio / generic。
STORAGE_PROVIDER=aws
# 存储桶所在地域（Region）。
# 示例：us-east-1（AWS）、oss-cn-hangzhou（阿里云）、ap-guangzhou（腾讯云）。
# 多数云厂商必填，用于拼接默认访问域名；为空时部分 SDK 无法定位服务。
STORAGE_REGION=us-east-1
# 自定义 S3 兼容服务地址（Endpoint）。
# 示例：https://play.min.io（MinIO）、https://cos.ap-guangzhou.myqcloud.com（腾讯云）。
# 仅当使用 MinIO、自建 Ceph 等自定义域名时填写；AWS / 阿里云 OSS / 腾讯云 COS 等主流厂商留空，
# 由 SDK 按厂商与 region 自动拼接。
STORAGE_ENDPOINT=
# 存储桶名称（图片对象存放的容器）。
# 示例：my-gallery-bucket ｜ 必填。
STORAGE_BUCKET=
# 访问密钥 ID（AK），用于后端上传 / 删除对象时的身份鉴权。
# 示例：AKIAIOSFODNN7EXAMPLE ｜ 必填；在对应云厂商的「访问控制 / API 密钥」处获取。
STORAGE_ACCESS_KEY=
# 密钥（SK），与 AK 配对使用。
# 示例：wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY ｜ 必填；注意保密，切勿提交到代码仓库。
STORAGE_SECRET_KEY=
# 是否强制路径风格（path-style）寻址。
# 示例：true / false ｜ MinIO、某些自建存储需设为 true；
# AWS / 阿里云 OSS / 腾讯云 COS 保持 false（使用虚拟主机风格 virtual-hosted）。
STORAGE_FORCE_PATH_STYLE=false
# 存储桶公网可访问的基础地址，后端用它拼接图片直链返回给前端。
# 示例：https://my-gallery-bucket.oss-cn-hangzhou.aliyuncs.com ｜ 必填；
# 需为「公开可读」的存储桶域名或 CDN 域名，前端据此直连对象存储加载图片。
STORAGE_PUBLIC_BASE_URL=