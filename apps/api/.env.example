# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
