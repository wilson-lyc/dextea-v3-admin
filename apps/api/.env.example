# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dextea

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos
NACOS_SERVER_ADDR=
NACOS_DATA_ID=dextea-admin
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=

# 高德地图 Web服务 API Key
AMAP_KEY=your-amap-web-service-key

# 高德地图 JavaScript API Key
AMAP_JS_KEY=your-amap-js-api-key
AMAP_JS_SECURITY_CODE=your_security_js_code

# ─── 全局唯一的 S3 对象存储连接配置（全应用共享，不再支持多存储位置） ───
# 厂商（当前仅支持 tencent / 腾讯云 COS）
S3_PROVIDER=tencent
# S3 区域，如 ap-guangzhou
S3_REGION=
# 自定义端点（S3 兼容服务地址）；留空则按厂商注册表模板自动拼接
S3_ENDPOINT=
# 存储桶名称
S3_BUCKET=
# 访问密钥 ID（SecretId）
S3_ACCESS_KEY_ID=
# 私密访问密钥（SecretKey）
S3_SECRET_ACCESS_KEY=
# 是否强制路径风格（virtual-hosted 与 path-style 区别）
S3_FORCE_PATH_STYLE=false
# 存储桶公网基础地址（用于直链访问，如 https://bucket.cos.ap-guangzhou.myqcloud.com）
S3_PUBLIC_BASE_URL=