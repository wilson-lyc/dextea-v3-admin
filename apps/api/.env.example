# Server
PORT=8196
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:8195
CORS_CREDENTIALS=true
NODE_ENV=development
LOG_LEVEL=info

# Nacos（管理员端的下游服务发现基础设施）
NACOS_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=

# 下游 gRPC 服务（启用 Nacos 时按服务名发现，地址作为静态兜底）
PRODUCT_SERVICE_NAME=dextea-product
PRODUCT_SERVICE_ADDR=127.0.0.1:9090
STORE_SERVICE_NAME=dextea-store-service
STORE_SERVICE_ADDR=127.0.0.1:9092
TRADE_SERVICE_NAME=dextea-trade
TRADE_SERVICE_ADDR=127.0.0.1:9091
XOS_SERVICE_NAME=dextea-xos
XOS_SERVICE_ADDR=127.0.0.1:9091
XOS_STORAGE_SOURCE=minio-dev

# MySQL Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=0

# 高德地图
AMAP_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# S3
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
